# Environment Variables Template for PrepPilot AI

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI & LLM Providers (Mistral AI Reasoning Engine)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Code Execution Sandbox (OneCompiler API)
ONECOMPILER_API_KEY=your_onecompiler_api_key

# Deepgram Voice AI & Real-time Speech-to-Text / Agent
DEEPGRAM_API_KEY=your_deepgram_api_key

# Backend URL (FastAPI Deployed or Localhost)
NEXT_PUBLIC_API_URL=https://social-impact-hackathon.vercel.app
